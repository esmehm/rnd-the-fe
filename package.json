{
  "name": "rnd-stocktake-thin-react",
  "version": "0.1.0",
  "private": true,
  "description": "Greenfield Thin-React stocktake screen — bake-off control arm (Rspack + React 19 + TanStack Table/Virtual + vanilla-extract + React Aria)",
  "scripts": {
    "dev": "rspack serve",
    "build": "rspack build",
    "preview": "rspack build && npx http-server dist -p 3100",
